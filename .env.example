# Hermes Modular Trading System - Configuration

# ============================================================================
# WALLET CONFIGURATION
# ============================================================================

# Testnet wallet address (public)
HYPERLIQUID_ACCOUNT_ADDRESS=0x9D103B638fe20D4cB933d1310641d6a24AD5B8Ab

# Testnet wallet private key (NEVER commit to git)
# Export from Rabby/Metamask: Settings → Security → Export Private Key
HYPERLIQUID_WALLET_PRIVATE_KEY=your_private_key_here

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Use testnet for development (true) or mainnet for production (false)
HYPERLIQUID_TESTNET=true

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Maximum concurrent positions
MAX_POSITIONS=5

# Risk per trade (% of equity)
RISK_PER_TRADE_PCT=2.0

# Minimum opportunity score (0-100)
MIN_OPPORTUNITY_SCORE=55

# Position size limits (USD)
MIN_POSITION_USD=20.0
MAX_POSITION_USD=500.0

# Maximum leverage
MAX_LEVERAGE=10

# ============================================================================
# KILL SWITCH CONFIGURATION
# ============================================================================

# Maximum daily loss (% of equity) - triggers pause
MAX_DAILY_LOSS_PCT=3.0

# Maximum weekly loss (% of equity) - triggers pause
MAX_WEEKLY_LOSS_PCT=7.0

# Maximum drawdown from peak (% of equity) - hard stop
MAX_DRAWDOWN_PCT=10.0

# ============================================================================
# TRAILING STOP CONFIGURATION
# ============================================================================

# Activate trailing stop after this profit %
TRAIL_ACTIVATION_PCT=2.0

# Trail distance from peak %
TRAIL_DISTANCE_PCT=5.0

# ============================================================================
# NOTIFICATION CONFIGURATION
# ============================================================================

# Telegram chat ID (required for notifications)
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Direct Telegram bot token (fallback)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Enable/disable notification types
SEND_ON_ENTRY=true
SEND_ON_SL=true
SEND_ON_TP=true
SEND_ON_CLOSE=true
SEND_ON_ERROR=true
SEND_ON_TRAIL_ADJUST=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log directory (relative to project root)
LOG_DIR=logs

# ============================================================================
# EXECUTION CONFIGURATION
# ============================================================================

# Run in dry-run mode (simulate without placing orders)
DRY_RUN=false

# Verify orders after placement
VERIFY_ORDERS=true

# Automatically close positions at TP/SL
AUTO_CLOSE=true

# ============================================================================
# CRON SCHEDULE (for reference)
# ============================================================================

# Pipeline: Run every 5 minutes
# */5 * * * * cd /path/to/crypto-trading-bot && python3 run_pipeline.py --account $HYPERLIQUID_ACCOUNT_ADDRESS

# Monitor: Run every 1 minute
# */1 * * * * cd /path/to/crypto-trading-bot && python3 run_monitor.py --single-run --account $HYPERLIQUID_ACCOUNT_ADDRESS
